{
  "name": "credit-note-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3210",
    "build": "next build",
    "test": "node --experimental-strip-types lib/calc.test.ts && node --experimental-strip-types lib/excel.test.ts && node --experimental-strip-types lib/pos.test.ts",
    "desktop": "next build && electron .",
    "desktop:dev": "ELECTRON_START_URL=http://localhost:3210 electron .",
    "dist:mac": "next build && electron-builder --mac --x64 --arm64 --publish never",
    "dist:win": "next build && electron-builder --win --x64 --publish never",
    "dist:linux": "next build && electron-builder --linux --x64 --publish never"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "read-excel-file": "^9.3.10",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.3.8",
    "typescript": "^7.0.2",
    "write-excel-file": "^4.1.1"
  },
  "type": "module",
  "description": "EOSS credit note calculator — desktop app",
  "author": "darshankochar22",
  "main": "electron/main.cjs",
  "build": {
    "appId": "app.creditnote.desktop",
    "productName": "Credit Note",
    "files": [
      "out/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.business"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    }
  }
}
